    "react-select": "^5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "gh-pages": "^5.0.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
